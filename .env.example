#--------------------------------------------------------------------
# .env.example — Feature 4: Replicación Asíncrona a NoSQL
#
# Copia este archivo como ".env" y ajusta los valores. NUNCA subas el
# ".env" real al repositorio: contiene credenciales y está en .gitignore.
#
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows / CMD)
#
# Los nombres pueden ajustarse cuando se implementen las HU indicadas.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# INSTANCIA MYSQL DE ORIGEN (HU-55)
#--------------------------------------------------------------------
# El sync-service solo lee de aquí, con un usuario de solo lectura (SELECT).
ORIGEN_DB_HOST=mysql-origen
ORIGEN_DB_PORT=3306
ORIGEN_DB_NAME=oficina_agua
ORIGEN_DB_USER=sync_ro
ORIGEN_DB_PASSWORD=cambiar_esta_password
# Usuario administrador del contenedor (solo para inicializarlo).
ORIGEN_DB_ROOT_PASSWORD=cambiar_esta_password_root
# Puerto del host distinto de 3306 para no chocar con el MySQL local (Laragon, XAMPP...).
ORIGEN_DB_HOST_PORT=3308

#--------------------------------------------------------------------
# AMAZON DYNAMODB LOCAL (HU-52)
#--------------------------------------------------------------------
# Desde otro contenedor: http://dynamodb:8000. Desde tu máquina (IntelliJ): http://localhost:8000.
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_HOST_PORT=8000
DYNAMODB_TABLE_RESUMEN=oficina_agua_resumen
# DynamoDB Local acepta cualquier valor; no son credenciales reales de AWS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

#--------------------------------------------------------------------
# SYNC-SERVICE (HU-51, HU-53)
#--------------------------------------------------------------------
SYNC_PORT=8083
# CAMBIO: variable nueva.
# Segundos que el Thread espera entre consultar lo pendiente y replicar (el job sigue EN_PROGRESO).
# 30 para ver el trabajo asincrono; 0 para que replique sin esperar (por ejemplo, en las pruebas).
SYNC_RETARDO_SEGUNDOS=30
# API key que deben enviar los clientes en la cabecera X-API-Key (HU-53). Inventa una y no la subas.
SYNC_API_KEY=cambiar_esta_api_key
